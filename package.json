{
  "name": "tokendex",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "pretest": "node -e \"if (+process.versions.node.split('.')[0] < 24) { console.error('npm test needs Node 24, from .nvmrc: run nvm use'); process.exit(1) }\"",
    "test": "vitest run && python3 -m unittest test_serve"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "html-to-image": "^1.11.13",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
